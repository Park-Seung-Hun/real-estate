# 공공데이터포털 인증키. 마이페이지의 Decoding 키를 쓴다.
DATA_GO_KR_SERVICE_KEY=your-decoding-key
# 조회할 시군구 법정동 코드 5자리.
LAWD_CD=12345
# 구글 OAuth 클라이언트(구글 클라우드 콘솔).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# 열 암호화 키 목록(`번호:base64` 형식)과 새로 쓸 키 번호. `openssl rand -base64 32`로 만든다.
ESTATE_COLUMN_KEYS=your-column-keys
ESTATE_COLUMN_KEY_ACTIVE=your-active-key-number
# 로그인 임시 쿠키 암호화 키. 열 키와 다른 값을 쓴다.
ESTATE_LOGIN_COOKIE_KEY=your-login-cookie-key
# 실거래 수집할 시군구 법정동 코드 5자리(쉼표로 여러 개). 비우면 수집하지 않는다.
ESTATE_COLLECTOR_REGIONS=
# 수집 예약 시각(Spring cron). 기본값은 매일 09:00(한국 시간).
ESTATE_COLLECTOR_CRON=0 0 9 * * *
# 원본 응답 버킷의 collector 키. scripts/garage-init.sh가 출력하는 값을 넣는다.
ESTATE_RAW_S3_ACCESS_KEY=your-raw-s3-access-key
ESTATE_RAW_S3_SECRET_KEY=your-raw-s3-secret-key
