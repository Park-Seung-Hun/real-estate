window:
  navbar:
    leading:
      backbutton "관심 단지"
    center:
      text "가족 초대" bold
  col 360:
    section "내 표시 이름":
      kv "지금 이름" "하나"
      input placeholder="새 이름"
      button "저장"
    section "함께 보는 사람":
      text "하나(나)  owner"
      text "hana@example.com" muted size=small
    text "만료 기간" muted
    combo "만료 기간" value="3일" options="1일, 2일, 3일, 4일, 5일, 6일, 7일"
    button "초대 링크 만들기" primary
    text "만든 링크를 복사해 메신저나 메일로 보냅니다." muted size=small
    divider
    button "가구 삭제"
