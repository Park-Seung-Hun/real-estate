<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.real-estate.data-probe</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__REPO__/spike/data-probe/probe.py</string>
        <string>fetch</string>
        <string>--months</string>
        <string>6</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__REPO__/.private/data/logs/data-probe.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/.private/data/logs/data-probe.err.log</string>
</dict>
</plist>
